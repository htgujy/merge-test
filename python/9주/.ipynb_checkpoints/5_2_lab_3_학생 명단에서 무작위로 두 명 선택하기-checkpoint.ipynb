   "source": [
    "- 입력받은 학생 수만큼 학생 이름을 입력받아 names 리스트에 저장한 다음 두 명을 무작위로 선택해 보기"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "Qg_q23UgO1Ud"
   },
   "outputs": [],
   "source": [
    "import random"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "uEF5AWH_N4n4"
   },
   "outputs": [],
   "source": [
    "names = []\n",
    "num = int(input('학생 수: '))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "U4qIkpBPOon3"
   },
   "outputs": [],
   "source": [
    "for i in range(num):\n",
    "  names.append(input('학생 이름: '))\n",
    "print(random.sample(names,2))"
   ]
  }
